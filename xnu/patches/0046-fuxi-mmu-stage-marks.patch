diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -797,6 +797,41 @@
 
-	// Enable caches, MMU, ROP and JOP
-	MOV64   x0, SCTLR_EL1_DEFAULT
-	MSR_SCTLR_EL1_X0
-	isb		sy
+	// Enable caches, MMU, ROP and JOP
+	/* 0046 stage C: solid bar at y=1500, 300x24 */
+	MOV64	x6, (0xB8000000 + 1500 * 4320)
+	mov	w7, #-1
+	mov	x8, #24
+	mov	x10, #4320
+Lfuxi_stageC_row:
+	mov	x9, #300
+	mov	x11, x6
+Lfuxi_stageC_pixel:
+	str	w7, [x11], #4
+	subs	x9, x9, #1
+	b.ne	Lfuxi_stageC_pixel
+	add	x6, x6, x10
+	subs	x8, x8, #1
+	b.ne	Lfuxi_stageC_row
+	dsb	sy
+
+	MOV64   x0, SCTLR_EL1_DEFAULT
+	MSR_SCTLR_EL1_X0
+	isb		sy
+
+	/* 0046 stage D: solid bar at y=1300, 300x24 */
+	MOV64	x6, (0xB8000000 + 1300 * 4320)
+	mov	w7, #-1
+	mov	x8, #24
+	mov	x10, #4320
+Lfuxi_stageD_row:
+	mov	x9, #300
+	mov	x11, x6
+Lfuxi_stageD_pixel:
+	str	w7, [x11], #4
+	subs	x9, x9, #1
+	b.ne	Lfuxi_stageD_pixel
+	add	x6, x6, x10
+	subs	x8, x8, #1
+	b.ne	Lfuxi_stageD_row
+	dsb	sy
+
 
