diff --git a/osfmk/kern/debug.c b/osfmk/kern/debug.c
index dbd23a4..0445337 100644
--- a/osfmk/kern/debug.c
+++ b/osfmk/kern/debug.c
@@ -1072,6 +1072,23 @@ panic_trap_to_debugger(const char *panic_format_str, va_list *panic_args, unsign
 {
 #pragma clang diagnostic pop
 
+	/* fuxi debug: 打印崩点寄存器并永久 halt（不 reboot），定位真机 panic */
+	{
+		uint64_t _far, _esr, _elr;
+		__asm__ volatile("mrs %0, far_el1" : "=r"(_far));
+		__asm__ volatile("mrs %0, esr_el1" : "=r"(_esr));
+		__asm__ volatile("mrs %0, elr_el1" : "=r"(_elr));
+		kprintf("FX-FAR=%016llx ESR=%08x ELR=%016llx\n", _far, _esr, _elr);
+		kprintf("FX-msg=%s\n", panic_format_str ? panic_format_str : "(null)");
+	}
+	for (;;) {
+#if defined(__arm64__) || defined(__arm__)
+		__builtin_arm_wfe();
+#else
+		__asm__ volatile("wfi");
+#endif
+	}
+
 #if defined(__x86_64__) && (DEVELOPMENT || DEBUG)
 	read_lbr();
 #endif
