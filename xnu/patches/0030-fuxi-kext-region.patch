diff --git a/makedefs/MakeInc.def b/makedefs/MakeInc.def
index 5bd6f23..993a1dc 100644
--- a/makedefs/MakeInc.def
+++ b/makedefs/MakeInc.def
@@ -334,6 +334,13 @@ ARM64_PLKSEG_ADDR  =0xfffffe0004004000
 ARM64_LINK_ADDR    =0xfffffe0007004000
 endif
 
+# FUXI: prelinked kexts need more room than the 16MB between virt_base and __TEXT.
+# Raising __TEXT to the top of the next 32MB block moves virt_base to
+# 0xfffffe0008000000 and grows the kext region to ~31MB.
+ifneq ($(filter FUXI,$(CURRENT_MACHINE_CONFIG)),)
+ARM64_LINK_ADDR    =0xfffffe0009f04000
+endif
+
 
 CFLAGS_ARM64	= -Darm64 -DARM64 -D__ARM64__ -DLP64 -DPAGE_SIZE_FIXED -DVM_KERNEL_LINK_ADDRESS=$(ARM64_LINK_ADDR) \
 			$(LARGE_MEMORY_DEFINE) -momit-leaf-frame-pointer -fno-strict-aliasing -D__API__=v4 -mkernel
