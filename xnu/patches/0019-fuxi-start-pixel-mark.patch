diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -219,7 +219,23 @@
  */
 	.align	3
 	.globl EXT(_start)
 LEXT(_start)
+
+	/* fuxi: 证明内核代码被执行 */
+	/* 先写一个像素并立刻 dsb（MMU 关着，写是缓冲的，不 dsb 可能丢） */
+	MOV64	x9, 0xB0000000
+	MOV64	x10, 0x0000FF00
+	str	w10, [x9]
+	dsb	sy
+	/* 再画一条 16 行高的绿带在 y=300 */
+	MOV64	x12, 0x13C800
+	add	x9, x9, x12
+	MOV64	x11, 17280
+	1:
+	str	w10, [x9], #4
+		subs	x11, x11, #1
+		b.ne	1b
+	dsb	sy
 	b	EXT(start_first_cpu)
 
 
