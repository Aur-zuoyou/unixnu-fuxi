diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -220,4 +220,20 @@
 	.align	3
 	.globl EXT(_start)
+
+	/* fuxi: 在 _start 第一条指令处画色块并停机。 */
+	/* 看到 = 内核代码从入口就开始执行了。 */
+	MOV64	x9, 0xB0000000
+	MOV64	x12, 0x59A600
+	add	x9, x9, x12
+	MOV64	x10, 0x00FF00FF
+	MOV64	x11, 51840
+	1:
+	str	w10, [x9], #4
+		subs	x11, x11, #1
+		b.ne	1b
+	dsb	sy
+	2:
+	wfi
+	b	2b
 LEXT(_start)
 	b	EXT(start_first_cpu)
