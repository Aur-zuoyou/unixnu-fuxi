diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -220,4 +220,18 @@
 	.align	3
 	.globl EXT(_start)
+
+	/* fuxi: 把整屏刷成绿色，然后停机。 */
+	/* 看到绿屏 = 内核代码从 _start 起点就在执行。 */
+	MOV64	x9, 0xB0000000
+	MOV64	x10, 0x0000FF00		// 绿
+	MOV64	x11, 2592000		// 1080 * 2400
+	1:
+	str	w10, [x9], #4
+		subs	x11, x11, #1
+		b.ne	1b
+	dsb	sy
+	2:
+	wfi
+	b	2b
 LEXT(_start)
 	b	EXT(start_first_cpu)
