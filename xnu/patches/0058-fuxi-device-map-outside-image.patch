diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -697,3 +697,28 @@
 	create_bootstrap_mapping x14, x15, x5, x3, x2, x9, x10, x11, x12, x13
+
+	/*
+	 * fuxi: outside the image window, map RAM as Device memory.
+	 * Qualcomm XPUs fault on speculative reads of protected carve-outs
+	 * (TZ, hyp, modem) that sit inside the mapped window; with Normal
+	 * cacheable attributes the CPU may speculatively touch them the
+	 * instant the MMU comes on, which raises an uncatchable fault.
+	 * The image itself stays Normal so unaligned accesses keep working.
+	 */
+	MOV64	x9, (1 << ARM_TT_L2_SHIFT)
+	add	x10, x23, #0x4000000
+	add	x11, x23, x24
+	add	x12, x25, #(2 * PGBYTES)
+	MOV64	x13, (ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_NX | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_DISABLE))
+9:
+	cmp	x10, x11
+	b.hs	8f
+	and	x8, x10, #(ARM_TT_L2_INDEX_MASK)
+	lsr	x8, x8, #(ARM_TT_L2_SHIFT)
+	orr	x7, x13, x10
+	str	x7, [x12, x8, lsl #TTE_SHIFT]
+	add	x10, x10, x9
+	b	9b
+8:
+	dsb	ish
 
 #if defined(ARM64_BOARD_CONFIG_FUXI)
