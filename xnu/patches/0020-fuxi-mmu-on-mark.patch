diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -743,6 +743,19 @@
 	// Enable caches, MMU, ROP and JOP
 	MOV64   x0, SCTLR_EL1_DEFAULT
 	MSR_SCTLR_EL1_X0
 	isb		sy
+
+	/* fuxi: MMU 已经打开——在 y=400 画一条 8 行高的蓝色色带 */
+	/* 用不同的颜色区分阶段：绿=进了 _start，蓝=MMU 开成功 */
+	MOV64	x9, 0xB0000000
+	MOV64	x12, 0x1A4000		// 400 * 4320
+	add	x9, x9, x12
+	MOV64	x10, 0x00FF0000		// 蓝
+	MOV64	x11, 8640		// 8 行 * 1080
+	1:
+	str	w10, [x9], #4
+		subs	x11, x11, #1
+		b.ne	1b
+	dsb	sy
 
 	MOV64   x1, SCTLR_EL1_DEFAULT
