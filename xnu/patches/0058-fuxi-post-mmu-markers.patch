--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -744,6 +744,23 @@
 	MOV64   x0, SCTLR_EL1_DEFAULT
 	MSR_SCTLR_EL1_X0
 	isb		sy
+	/* 0058 fuxi post-MMU marker @ y=880 */
+	MOV64	x0, (0xB8000000 + 880 * 4320)
+	mov	w1, #-1
+	mov	x2, #24
+	mov	x4, #4320
+Lfuxi_postmmu_row:
+	mov	x3, #200
+	mov	x5, x0
+Lfuxi_postmmu_pixel:
+	str	w1, [x5], #4
+	subs	x3, x3, #1
+	b.ne	Lfuxi_postmmu_pixel
+	add	x0, x0, x4
+	subs	x2, x2, #1
+	b.ne	Lfuxi_postmmu_row
+	dsb	sy
+
 
 #if !VMAPPLE
 	MOV64   x1, SCTLR_EL1_DEFAULT
@@ -808,6 +825,23 @@
 #endif
 
 	// Return to arm_init()
+	/* 0058 fuxi start.s complete marker @ y=840 */
+	MOV64	x0, (0xB8000000 + 840 * 4320)
+	mov	w1, #-1
+	mov	x2, #24
+	mov	x4, #4320
+Lfuxi_startdone_row:
+	mov	x3, #200
+	mov	x5, x0
+Lfuxi_startdone_pixel:
+	str	w1, [x5], #4
+	subs	x3, x3, #1
+	b.ne	Lfuxi_startdone_pixel
+	add	x0, x0, x4
+	subs	x2, x2, #1
+	b.ne	Lfuxi_startdone_row
+	dsb	sy
+
 	ret
 
 Ltrampoline:
