--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -996,6 +996,23 @@
 	mov		x0, #(CPACR_FPEN_ENABLE)
 	msr		CPACR_EL1, x0
 #endif
+	/* 0058 fuxi postcpacr marker @ y=780 */
+	MOV64	x0, (0xB8000000 + 780 * 4320)
