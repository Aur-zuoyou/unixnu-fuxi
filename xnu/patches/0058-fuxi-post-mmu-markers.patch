+	b.ne	Lfuxi_posttunables_row
+	dsb	sy
+
 
 
 #if HAS_CLUSTER
@@ -1023,6 +1057,23 @@
 
 	// If x21 != 0, we're doing a warm reset, so we need to trampoline to the kernel pmap.
 	cbnz	x21, Ltrampoline
+	/* 0058 fuxi postcbnz marker @ y=660 */
+	MOV64	x0, (0xB8000000 + 660 * 4320)
+	mov	w1, #-1
+	mov	x2, #24
+	mov	x4, #4320
+Lfuxi_postcbnz_row:
+	mov	x3, #200
+	mov	x5, x0
+Lfuxi_postcbnz_pixel:
+	str	w1, [x5], #4
