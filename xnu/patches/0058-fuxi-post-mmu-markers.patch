 	// Set KVA of boot args as first arg
 	add		x0, x20, x22
@@ -1040,6 +1091,23 @@
 	mov	x0, x20
 	mov	lr, x21
 #endif
+
+	/* 0058 fuxi startdone marker @ y=840 */
