+	add	x0, x0, x4
+	subs	x2, x2, #1
+	b.ne	Lfuxi_postcpacr_row
+	dsb	sy
+
 
 	// Clear thread pointer
 	msr		TPIDR_EL1, xzr						// Set thread register
@@ -1012,6 +1029,23 @@
 	mrs x12, MIDR_EL1
 
