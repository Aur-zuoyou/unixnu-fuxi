diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -901,2 +901,33 @@
 
+	/* 0056: record the MMU inputs so a failed enable can be read back after
+	 * reboot (DarwinBoot prints them). Lives at 0xB89E0100, magic FUXIREGS. */
+	adr	x5, .
+	lsr	x6, x5, #30
+	and	x6, x6, #0x1FF
+	lsl	x6, x6, #3
+	ldr	x7, [x25, x6]
+	/* L1 entry for the PC page */
+	and	x8, x7, #0x0000FFFFFFFFF000
+	/* L2 table PA from that entry */
+	lsr	x9, x5, #21
+	and	x9, x9, #0x1FF
+	lsl	x9, x9, #3
+	ldr	x10, [x8, x9]
+	/* L2 entry covering the PC */
+	MOV64	x0, 0xB89E0100
+	MOV64	x1, 0x5347455249585546
+	/* "FUXIREGS" */
+	stp	x1, x25, [x0, #0]
+	mrs	x1, TTBR0_EL1
+	mrs	x2, TCR_EL1
+	stp	x1, x2, [x0, #16]
+	mrs	x1, MAIR_EL1
+	mrs	x2, TTBR1_EL1
+	stp	x1, x2, [x0, #32]
+	mrs	x1, SCTLR_EL1
+	stp	x1, x7, [x0, #48]
+	/* SCTLR, L1 entry */
+	stp	x10, x5, [x0, #64]
+	/* L2 entry, PC */
+	dsb	sy
 	MOV64   x0, SCTLR_EL1_DEFAULT
